# ==========================================
# EduPulse AI - Project Ignore Rules
# ==========================================

# --- Environment & Sensitive Variables ---
# Do not upload API keys or environment secrets
.env
.env*
*.pem
*.key
*.secret
api_keys.json
lib/core/constants.dart

# --- Flutter / Dart Specifics ---
# Build artifacts and dependency caches
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins-dependencies
build/
**/ios/Flutter/.last_build_id

# --- Platform Specific Builds ---
# Ignore desktop/web builds if only focusing on mobile
/android/app/debug
/android/app/profile
/android/app/release
frontend/build/
frontend/web/
frontend/macos/
frontend/linux/
frontend/windows/

# --- Firebase & Backend ---
# Local Firebase CLI cache and service account keys
.firebase/
firebase-debug.log
backend/serviceAccountKey.json
backend/.env
backend/static/
backend/add_textbook.py

# --- Python & Virtual Environments ---
# Compiled python files and local virtual envs
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
bin/

# --- Android Signing & Local Config ---
# Security files for app signing and local SDK paths
android/key.properties
android/app/*.keystore
android/app/*.jks
android/local.properties
local.properties

# --- Data & Large Files ---
# Prevent large datasets or model weights from being tracked
data/
datasets/
*.csv
*.json
!manifest.json
*.h5
*.pt
*.onnx
*.weights
*.bin

# --- IDEs & System Garbage ---
# User-specific editor configurations and OS files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
*.log